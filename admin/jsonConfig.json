{
    "i18n": true,
    "type": "panel",
    "items": {
        "_cmsHeader": { "type": "header", "text": "cmsHeader", "size": 2 },
        "url": {
            "type": "text",
            "label": "urlLabel",
            "help": "urlHelp",
            "xs": 12, "sm": 12, "md": 6, "lg": 6, "xl": 6,
            "placeholder": "urlPlaceholder"
        },
        "clientId": {
            "type": "text",
            "label": "clientIdLabel",
            "help": "clientIdHelp",
            "xs": 12, "sm": 12, "md": 6, "lg": 6, "xl": 6
        },
        "clientSecret": {
            "type": "password",
            "label": "clientSecretLabel",
            "help": "clientSecretHelp",
            "xs": 12, "sm": 12, "md": 6, "lg": 6, "xl": 6,
            "repeat": false,
            "visible": true
        },

        "_scopeHeader": { "type": "header", "text": "scopeHeader", "size": 2 },
        "layoutFolder": {
            "type": "text",
            "label": "layoutFolderLabel",
            "help": "layoutFolderHelp",
            "xs": 12, "sm": 12, "md": 6, "lg": 6, "xl": 6,
            "placeholder": "layoutFolderPlaceholder"
        },
        "defaultChangeDuration": {
            "type": "number",
            "label": "defaultChangeDurationLabel",
            "help": "defaultChangeDurationHelp",
            "xs": 12, "sm": 12, "md": 6, "lg": 6, "xl": 6,
            "min": 0,
            "max": 86400
        },

        "_pollHeader": { "type": "header", "text": "pollHeader", "size": 2 },
        "inventoryPollInterval": {
            "type": "number",
            "label": "inventoryPollIntervalLabel",
            "help": "inventoryPollIntervalHelp",
            "xs": 12, "sm": 12, "md": 4, "lg": 4, "xl": 4,
            "min": 30000,
            "max": 86400000
        },
        "statusPollInterval": {
            "type": "number",
            "label": "statusPollIntervalLabel",
            "help": "statusPollIntervalHelp",
            "xs": 12, "sm": 12, "md": 4, "lg": 4, "xl": 4,
            "min": 5000,
            "max": 3600000
        },
        "requestTimeout": {
            "type": "number",
            "label": "requestTimeoutLabel",
            "help": "requestTimeoutHelp",
            "xs": 12, "sm": 12, "md": 4, "lg": 4, "xl": 4,
            "min": 2000,
            "max": 120000
        }
    }
}
