{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compileOnSave": true,
    "compilerOptions": {
        "resolveJsonModule": true,
        "declaration": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "sourceMap": true,
        "types": [
            "@iobroker/types",
            "node",
            "mocha",
            "chai"
        ],
        "noEmit": true
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": [
        "node_modules/**",
        "build/**"
    ]
}
