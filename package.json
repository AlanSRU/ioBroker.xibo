{
  "name": "iobroker.xibo",
  "version": "0.1.0",
  "description": "Control Xibo digital signage displays: change the layout playing on a display group, revert to schedule, and read display status.",
  "author": {
    "name": "Alan Paris"
  },
  "homepage": "https://github.com/AlanSRU/ioBroker.xibo",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "xibo",
    "digital signage",
    "led"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanSRU/ioBroker.xibo.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit",
    "lint": "eslint --ext .ts src/",
    "test": "mocha --require ts-node/register test/**/*.test.ts --exit"
  },
  "devDependencies": {
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/testing": "^5.2.2",
    "@iobroker/types": "^6.0.11",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "mocha": "^12.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1"
  }
}
