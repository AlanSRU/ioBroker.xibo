{
  "name": "iobroker.xibo",
  "version": "0.2.0",
  "description": "Control Xibo digital signage displays: change the layout playing on a display group, revert to schedule, and read display status.",
  "author": {
    "name": "Alan Paris"
  },
  "homepage": "https://github.com/AlanSRU/ioBroker.xibo",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "xibo",
    "digital signage",
    "led"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlanSRU/ioBroker.xibo.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "mocha --require ts-node/register \"test/*.test.ts\" --exit",
    "test:package": "mocha --require ts-node/register test/package.test.ts --exit",
    "test:integration": "mocha --require ts-node/register \"test/integration/*.test.ts\" --exit",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@iobroker/types": "^6.0.11",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1"
  },
  "bugs": {
    "url": "https://github.com/AlanSRU/ioBroker.xibo/issues"
  }
}
